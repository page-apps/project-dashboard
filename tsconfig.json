{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": ["apps/web/src", "apps/web/vite.config.ts", "playwright.config.ts", "repo-app.config.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "e2e", "apps/web/dist"]
}
